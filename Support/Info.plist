<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleExecutable</key>
    <string>IcecastControl</string>
    <key>CFBundleIdentifier</key>
    <string>io.github.bigdumbrobot.IcecastControl</string>
    <key>CFBundleName</key>
    <string>Icecast Control</string>
    <key>CFBundleDisplayName</key>
    <string>Icecast Control</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>CFBundleIconFile</key>
    <string>AppIcon</string>
    <key>LSMinimumSystemVersion</key>
    <string>14.2</string>
    <!-- Menu bar only: no Dock icon. -->
    <key>LSUIElement</key>
    <true/>
    <key>NSMicrophoneUsageDescription</key>
    <string>Icecast Control broadcasts the audio input you choose (an interface, microphone or BlackHole) to your stream.</string>
    <key>NSAudioCaptureUsageDescription</key>
    <string>Icecast Control can broadcast everything this Mac plays to your stream.</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <!-- Icecast serves plain http, both locally and on the public host name.
         Don't add NSAllowsLocalNetworking here: it makes macOS ignore NSAllowsArbitraryLoads. -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsArbitraryLoads</key>
        <true/>
    </dict>
</dict>
</plist>
